{
  "name": "lan_web_homepage",
  "version": "1.0.0",
  "description": "兰芯云朵的静态官网：大陆灰云直连阿里云 Nginx；海外（含港澳台）走 global.lancloudtech.com Cloudflare Pages。",
  "main": "main.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "oss": "node scripts/oss/cli.mjs",
    "oss:ping": "node scripts/oss/cli.mjs ping",
    "oss:sync": "node scripts/oss/cli.mjs sync-website-images",
    "oss:rewrite": "node scripts/oss/rewrite-html-assets.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "seo:sync": "node scripts/patch-seo-heads.mjs && node scripts/generate-sitemap.mjs",
    "seo:verify": "node scripts/verify-seo.mjs",
    "geo:verify": "node scripts/verify-geo-host.mjs",
    "prepare:dist": "node scripts/prepare-worker-assets.mjs",
    "prepare:pages": "node scripts/prepare-pages-assets.mjs",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "deploy:geo-worker": "npx wrangler deploy --config workers/geo/wrangler.toml",
    "dns:global": "node scripts/cf-dns-global-pages.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LAN-Cloud-AI/LAN_Web_Homepage.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/LAN-Cloud-AI/LAN_Web_Homepage/issues"
  },
  "homepage": "https://github.com/LAN-Cloud-AI/LAN_Web_Homepage#readme",
  "dependencies": {
    "ali-oss": "^6.23.0",
    "dotenv": "^17.4.2"
  }
}
